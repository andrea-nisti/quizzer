exports_files([
    "x11-gl.tar.xz",
    "x11.bzl",
])

# The injected module BUILD files reach the X11/GL files through this alias:
# their repo mapping cannot resolve the main module's repo names, so they use
# the canonical label @@//third_party/x11:x11_gl, and this alias performs the
# lookup in the main module's mapping.
alias(
    name = "x11_gl",
    actual = "@x11_gl//:x11_gl",
    visibility = ["//visibility:public"],
)