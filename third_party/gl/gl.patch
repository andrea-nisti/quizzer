--- /dev/null
+++ b/v2.1/gl/BUILD.bazel
@@ -0,0 +1,43 @@
+load("@io_bazel_rules_go//go:def.bzl", "go_library")
+
+go_library(
+    name = "gl",
+    srcs = [
+        "conversions.go",
+        "debug.go",
+        "package.go",
+        "procaddr.go",
+    ],
+    cdeps = select({
+        # Canonical label: a repo generated by Gazelle cannot resolve the main
