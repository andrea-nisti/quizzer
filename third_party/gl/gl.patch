+        "@io_bazel_rules_go//go/platform:linux": ["@@//third_party/x11:x11_gl"],
+        "//conditions:default": [],
+    }),
+    cgo = True,
+    clinkopts = select({
+        "@io_bazel_rules_go//go/platform:darwin": ["-framework OpenGL"],
+        "@io_bazel_rules_go//go/platform:ios": ["-framework OpenGL"],
+        "@io_bazel_rules_go//go/platform:windows": ["-lopengl32"],
+        "//conditions:default": [],
+    }),
+    copts = select({
+        "@io_bazel_rules_go//go/platform:android": ["-DTAG_POSIX"],
+        "@io_bazel_rules_go//go/platform:darwin": ["-DTAG_DARWIN"],
+        "@io_bazel_rules_go//go/platform:freebsd": ["-DTAG_POSIX"],
+        "@io_bazel_rules_go//go/platform:ios": ["-DTAG_DARWIN"],
+        "@io_bazel_rules_go//go/platform:linux": ["-DTAG_POSIX"],
+        "@io_bazel_rules_go//go/platform:netbsd": ["-DTAG_POSIX"],
+        "@io_bazel_rules_go//go/platform:openbsd": ["-DTAG_POSIX"],
+        "@io_bazel_rules_go//go/platform:windows": ["-DTAG_WINDOWS"],
+        "//conditions:default": [],
+    }),
+    importpath = "github.com/go-gl/gl/v2.1/gl",
+    visibility = ["//visibility:public"],
+)
+
+alias(
+    name = "go_default_library",
+    actual = ":gl",
+    visibility = ["//visibility:public"],
+)
