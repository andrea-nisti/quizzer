load("@rules_go//go:def.bzl", "go_binary", "go_library")

# The library carries the import path of the package, so that the GOPATH
# tree the language server reads holds it under that path.
go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/andrea-nisti/quizzer/cmd",
    visibility = ["//:__pkg__"],
    deps = [
        "@io_fyne_fyne_v2//app",
        "@io_fyne_fyne_v2//widget",
    ],
)

go_binary(
    name = "main",
    embed = [":cmd_lib"],
)
