module(
    name = "quizzer",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "llvm", version = "0.8.0")

# Direct dependency: the generated @x11_sysroot BUILD and the injected module
# BUILD files load their cc rules from @rules_cc.
bazel_dep(name = "rules_cc", version = "0.2.18")

# One hermetic C toolchain for both targets: the llvm module cross builds the
# glibc and MinGW-w64 runtimes it links against, so libc needs no sysroot pin.
# X11/GL development files are not part of it and come from @x11_sysroot.
llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchains.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchains.target(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchains.target(
    arch = "x86_64",
    os = "windows",
)
use_repo(llvm_toolchains, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# The chrome-linux-sysroot packaged X11/GL beside its libc; only the X11/GL
# subset is still needed, so third_party/x11 prunes the tree it extracts.
x11_sysroot = use_repo_rule("//third_party/x11:x11_sysroot.bzl", "x11_sysroot")

x11_sysroot(
    name = "x11_sysroot",
    sha256 = "f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    urls = [
        "https://commondatastorage.googleapis.com/chrome-linux-sysroot/f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    ],
)

go_sdk = use_extension(
    "@rules_go//go:extensions.bzl",
    "go_sdk",
)
go_sdk.download(
    name = "go_sdk",
    version = "1.27.2",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Run `bazel mod tidy` after changing go.mod.
use_repo(
    go_deps,
    "io_fyne_fyne_v2",
)

# The GLFW bindings include their bundled C sources relative to the module
# root; give the module the hand written BUILD file in third_party/glfw.
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/go-gl/glfw/v3.3/glfw",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/glfw:glfw.patch"],
    path = "github.com/go-gl/glfw/v3.3/glfw",
)

# go-gl/gl needs a hand-written BUILD and patch for cgo include paths on Linux.
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/go-gl/gl",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/gl:gl.patch"],
    path = "github.com/go-gl/gl",
)
